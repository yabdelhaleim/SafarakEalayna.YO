###############################################
# Phase 25 Stress Environment
# Loaded automatically by `php artisan ... --env=stress`
# or when APP_ENV=stress is set.
# DO NOT use this file outside the stress harness.
###############################################

APP_NAME="SafarakEalayna-STRESS"
APP_ENV=stress
APP_KEY=base64:wCRDVlp1dgX/xr6HL9JKocIekv7gw6GOnioEMpphvyE=
APP_DEBUG=true
APP_URL=http://127.0.0.1:18000

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Default connection: MySQL safarak_stress (true concurrency tier).
# For SQLite bulk tier the stress scripts override DB_CONNECTION/DB_DATABASE via shell env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=safarak_stress
DB_USERNAME=root
DB_PASSWORD=

# --- Optional SQLite bulk path. The SQLite scripts use:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=/abs/path/to/storage/app/stress.sqlite

BROADCAST_DRIVER=log
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array

TELESCOPE_ENABLED=false
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false

# --- Account safety guards (matches production defaults).
ACCOUNTING_BALANCE_GUARD_BLOCK_UNAUTHORIZED_UPDATES=true
ACCOUNTING_STRICT_DOUBLE_ENTRY=true
ACCOUNTING_ALLOW_LEGACY_SINGLE_LEG_FALLBACK=false

BCRYPT_ROUNDS=4
