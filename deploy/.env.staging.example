# -----------------------------------------------------------------------------
# .env.staging.example — staging overrides for the Travel Office System
# Copy to .env.staging on the SERVER (NOT committed to git), then run:
#     php artisan key:generate
# -----------------------------------------------------------------------------
# ⚠️  STAGING ONLY. APP_ENV=staging makes Laravel auto-load this file on top of
# the base .env. Keep the staging DB name distinct (default: safarakealayna_staging)
# and never point this file at the production database.
# -----------------------------------------------------------------------------

APP_NAME="Travel Office System (STG)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---- logging --------------------------------------------------------------
# More verbose than production so you can debug staging issues.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- database (separate staging schema) -----------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=safarakealayna_staging
DB_USERNAME=travel_app
DB_PASSWORD=change-me-strong-password

# ---- session / cache / queue ----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
CACHE_STORE=database
CACHE_PREFIX=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---- sanctum (Vue SPA / API tokens) ---------------------------------------
SANCTUM_STATEFUL_DOMAINS=staging.your-domain.com
SANCTUM_EXPIRATION=

# ---- mail (use log driver so staging mail never escapes) ------------------
MAIL_MAILER=log
MAIL_HOST=staging-mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="staging@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- CORS (staging frontend origin) ---------------------------------------
CORS_ALLOWED_ORIGINS=https://staging.your-domain.com
CORS_ALLOWED_ORIGINS_PATTERNS=https://*.staging.your-domain.com

# ---- trusted proxies (Nginx in front of PHP-FPM) -------------------------
# TRUSTED_PROXIES="*"
